# Back and Apply stay visible until they leave the options screen (#41, #46).
start main-menu
# Verification uses a fresh profile. Fail rather than overwrite an unexpected baseline.
expect settings_default_detail == 1
expect settings_windowed == 0
snapshot original-options
click "Game Options Button"
until visible "Back"
expect-visible "Apply"
capture options-opened          # also inspect the resolution list; headless runs have no monitor
move "Back"
wait 30                         # Back must stay visible while hovered
expect-visible "Back"
capture options-back-hovered
click "High Detail"
click "Windowed"
wait 30                         # Back and Apply must stay visible while other controls change
expect-visible "Back"
expect-visible "Apply"
capture options-before-apply
click "Apply"
until hidden "Settings Panel"
until visible "Game Options Button"
expect settings_highest_detail == 1
expect settings_windowed == 1
snapshot accepted-options
click "Game Options Button"
until visible "Back"
expect-visible "Apply"
expect settings_draft_matches_accepted == 1
expect settings_draft_clean == 1
click "Medium Detail"
click "Fullscreen"
click "MOTDEnabledButton"
wait 30                         # Back and Apply must stay visible while other controls change
expect-visible "Back"
expect-visible "Apply"
expect settings_draft_matches_accepted == 0
expect settings_draft_clean == 0
expect settings_highest_detail == @accepted-options
expect settings_windowed == @accepted-options
expect settings_motd == @accepted-options
capture options-before-cancel
click "Back"
until hidden "Settings Panel"
until visible "Game Options Button"
expect settings_highest_detail == @accepted-options
expect settings_windowed == @accepted-options
expect settings_motd == @accepted-options
expect settings_draft_matches_accepted == 1
expect settings_draft_clean == 1
click "Game Options Button"
until visible "Back"
expect-visible "Apply"
expect settings_draft_matches_accepted == 1
expect settings_draft_clean == 1
capture options-reopened-after-cancel
# Reverse Apply through the same controls; cancelled MOTD never changed the profile.
click "Medium Detail"          # authored "high detail", the fresh-profile preset
click "Fullscreen"
click "Apply"
until hidden "Settings Panel"
until visible "Game Options Button"
expect settings_default_detail == 1
expect settings_highest_detail == @original-options
expect settings_windowed == @original-options
expect settings_motd == @original-options
# Apply closes the draft; reopening must use the accepted baseline.
click "Game Options Button"
until visible "Back"
expect settings_draft_matches_accepted == 1
expect settings_draft_clean == 1
click "Back"
until hidden "Settings Panel"
until visible "Game Options Button"
