# Scenery previews are valid on open ground and invalid over the road (#82)
# or over an object already placed there (#81).
start freeform-map
click "construction"
click "Scenery Tab"
wait 30                         # the tab's own icons replace the previous tab's
click "icon" 1
move 820 440
until placement_valid_previews == 1
expect placement_visible_previews == 1
capture scenery-open-ground
move 700 300                    # asphalt road
until placement_valid_previews == 0
capture scenery-over-road
snapshot before-scenery-placement
move 820 440
until placement_valid_previews == 1
click 820 440
until placed_objects > @before-scenery-placement
until placement_valid_previews == 0              # the repeat preview overlaps it
capture scenery-over-placed-object
key ESCAPE
until placement_previews == 0
key CTRL+Z
until placed_objects == @before-scenery-placement

restore freeform-map
