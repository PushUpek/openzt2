# diagnostic: run alone with --budget 900
# An ankylosaurus, whose clips are the doedicurus's with capitalised joint
# names (`Bip01`) on a model with lowercase ones (`bip01`), binds its root
# motion joint and gets a navigation agent, so it can walk.
start freeform-map
snapshot before-habitat
click "construction"
click "Fence Tab"
select-catalogue "chainlink"
snapshot fence-start
click 1000 220
click 1350 220
until fences > @fence-start
snapshot fence-start
click 1350 470
until fences > @fence-start
snapshot fence-start
click 1000 470
until fences > @fence-start
snapshot fence-start
click 1000 220
until fences > @fence-start
key ESCAPE
until placement_previews == 0
until habitats == @before-habitat+1
click "animals"
until rows "Animal Typelist" >= 1
click "Buy Animal Tab"
until rows "Animal Typelist" >= 1
wheel-to-catalogue "ankylosaurus"
select-catalogue "ankylosaurus" in "Animal Typelist"
move 1170 340
until placement_valid_previews == 1
click 1170 340
until contained_animals == 1
until placement_previews == 0
until animated_animals == 1 within 3600
until navigable_animals == 1 within 3600
capture ankylosaurus-navigable
