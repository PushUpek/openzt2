# Returning to an animal purchase tab restores its valid remembered subject (#96).
start freeform-map
click "animals"
until rows "Animal Typelist" >= 1
# Inherited-visible rows can precede the Buy Area's authored slide and layout.
# Wait for this target's populated row and clipped scroll viewport, then use
# the ordinary wheel/picking path. A missing target or viewport still fails.
until catalogue_ibex_wheel_ready == 1 within 120
snapshot animal-catalogue-ready
wheel-to-catalogue "ibex" in "Animal Typelist"
expect camera_x_m == @animal-catalogue-ready
expect camera_z_m == @animal-catalogue-ready
expect camera_height_m == @animal-catalogue-ready
expect camera_pitch_deg == @animal-catalogue-ready
expect camera_fov_deg == @animal-catalogue-ready
select-catalogue "ibex" in "Animal Typelist"
move 800 400
until catalogue_selected_is_ibex == 1
until catalogue_selected_visible_rows == 1
until text "Entity Name Label" "Ibex"
until text "Cost Display" "$3,000"
until catalogue_matching_placement_previews == 1
expect placement_previews == 1
until animal_preview_animated_visible_meshes > 0
until catalogue_detail_preview_scenes == 1
until catalogue_detail_preview_matching_visible_meshes > 0
expect catalogue_selected_is_bamboo_trough == 0
# Named captures require independent review of the highlight, portrait and ghost.
capture animal-selected
click "Animal Food Tab"
until rows "Food Typelist" >= 1
until catalogue_bamboo_wheel_ready == 1 within 120
snapshot food-catalogue-ready
wheel-to-catalogue "trough_bamboo" in "Food Typelist"
expect camera_x_m == @food-catalogue-ready
expect camera_z_m == @food-catalogue-ready
expect camera_height_m == @food-catalogue-ready
expect camera_pitch_deg == @food-catalogue-ready
expect camera_fov_deg == @food-catalogue-ready
select-catalogue "trough_bamboo" in "Food Typelist"
move 820 400
until catalogue_selected_is_bamboo_trough == 1
until catalogue_selected_visible_rows == 1
until text "Entity Name Label" "Food Trough with Bamboo"
until text "Cost Display" "$900"
until catalogue_matching_placement_previews == 1
expect placement_previews == 1
until catalogue_detail_preview_scenes == 1
until catalogue_detail_preview_matching_visible_meshes > 0
expect catalogue_selected_is_ibex == 0
capture food-selected
click "Buy Animal Tab"
move 800 400
until catalogue_selected_is_ibex == 1
until catalogue_selected_visible_rows == 1
until text "Entity Name Label" "Ibex"
until text "Cost Display" "$3,000"
until catalogue_matching_placement_previews == 1
expect placement_previews == 1
until animal_preview_animated_visible_meshes > 0
until catalogue_detail_preview_scenes == 1
until catalogue_detail_preview_matching_visible_meshes > 0
expect catalogue_selected_is_bamboo_trough == 0
# Named captures require independent review of the highlight, portrait and ghost.
capture animal-tab-returned
# No second row press: the tab's authored activation must restore both memories.
click "Animal Food Tab"
move 820 400
until catalogue_selected_is_bamboo_trough == 1
until catalogue_selected_visible_rows == 1
until text "Entity Name Label" "Food Trough with Bamboo"
until text "Cost Display" "$900"
until catalogue_matching_placement_previews == 1
expect placement_previews == 1
until catalogue_detail_preview_scenes == 1
until catalogue_detail_preview_matching_visible_meshes > 0
expect catalogue_selected_is_ibex == 0
capture food-tab-returned
key ESCAPE
until placement_previews == 0

restore freeform-map
