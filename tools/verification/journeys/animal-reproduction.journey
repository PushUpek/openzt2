# diagnostic: run alone with --budget 3600 and OPENZT2_SIMULATION_SPEED_MULTIPLIER=3
# An adult female and male aardvark mate, the female becomes pregnant and,
# after the authored 971.84 s gestation, gives birth to young (#97).
start freeform-map
snapshot before-habitat
click "construction"
click "Fence Tab"
select-catalogue "chainlink"
snapshot fence-start
click 1000 220
click 1350 220
until fences > @fence-start
snapshot fence-start
click 1350 470
until fences > @fence-start
snapshot fence-start
click 1000 470
until fences > @fence-start
snapshot fence-start
click 1000 220
until fences > @fence-start
key ESCAPE
until placement_previews == 0
until habitats == @before-habitat+1
click "animals"
until rows "Animal Typelist" >= 1
click "Animal Food Tab"
wheel-to-catalogue "hollowlog_insects"
select-catalogue "hollowlog_insects" in "Food Typelist"
move 1120 320
until placement_valid_previews == 1
click 1120 320
until food_placed_objects == 1
key ESCAPE
until placement_previews == 0
wheel-to-catalogue "fooddish_water"
select-catalogue "fooddish_water" in "Food Typelist"
move 1300 290
until placement_valid_previews == 1
click 1300 290
until food_placed_objects == 2
key ESCAPE
until placement_previews == 0
click "Buy Animal Tab"
until rows "Animal Typelist" >= 1
click "Female Button"
select-catalogue "aardvark" in "Animal Typelist"
move 1170 340
until placement_valid_previews == 1
click 1170 340
until contained_animals == 1
until placement_previews == 0
click "Male button"
select-catalogue "aardvark" in "Animal Typelist"
move 1220 380
until placement_valid_previews == 1
click 1220 380
until contained_animals == 2
until placement_previews == 0
expect female_animals == 1
expect male_animals == 1
capture aardvark-pair
snapshot pair
until pregnant_animals == 1 within 36000
capture pregnant
until young_animals > 0 within 216000
capture born
expect young_animals_with_mother == @born.young_animals
expect pregnant_animals == 0
