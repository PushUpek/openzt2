# Selecting world objects opens the right panel, the close button hides it (#63),
# and selecting the entrance does not keep showing the previous object (#73).
start freeform-map
click 930 425                   # tree beside the entrance path
until visible "Tree Info"       # the info panel document is projected on first use
expect selected == 1
capture tree-selected
click "close"
until hidden "Tree Info"
expect selected == 0
click 930 425
until visible "Tree Info"
click 560 450                   # zoo entrance gate
until visible "zoo status layout"      # the entrance opens zoo information instead
expect-hidden "Tree Info"
capture entrance-selected
click "close"
until hidden "zoo status layout"

# The goals control is also available without a challenge.
click "scenariogoals"
until visible "goals layout"
capture goals-without-challenge
key ESCAPE
until hidden "goals layout"

restore freeform-map
