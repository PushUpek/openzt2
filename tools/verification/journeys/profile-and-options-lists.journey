# The profile dialog lists profiles and closes by Escape, its close button and
# OK, leaving the main menu usable. The shell goes with it, so "hidden" on the
# shell means the whole dialog document closed.
start main-menu
until main_menu_profile_visible_text_owners == 1
expect main_menu_profile_readable_bound_names == 1
expect-text "currentprofile" "Default Profile"
capture main-menu-profile
click "profile_manager_opener"
until visible "profile_manager_dialog"
until rows "profilelist" >= 1          # the run starts with the default profile
until profile_visible_populated_rows >= 1
expect-text "ProfileEntry" "Default Profile"
click-row "profilelist" 0
expect-text "Profile_Display" "Default Profile"
capture profile-dialog
key ESCAPE
until hidden "profile_manager_dialog_shell"
until main_menu_profile_visible_text_owners == 1
expect main_menu_profile_readable_bound_names == 1
click "profile_manager_opener"
until visible "profile_manager_dialog"
until rows "profilelist" >= 1          # reopening projects the dialog afresh
until profile_visible_populated_rows >= 1
expect-text "ProfileEntry" "Default Profile"
click "cancel"
until hidden "profile_manager_dialog_shell"
until main_menu_profile_visible_text_owners == 1
expect main_menu_profile_readable_bound_names == 1
click "profile_manager_opener"
until visible "profile_manager_dialog"
until profile_visible_populated_rows >= 1
expect-text "ProfileEntry" "Default Profile"
click "continue_button"
until hidden "profile_manager_dialog_shell"
until main_menu_profile_visible_text_owners == 1
expect main_menu_profile_readable_bound_names == 1
expect-text "currentprofile" "Default Profile"
capture main-menu-profile-after-continue
