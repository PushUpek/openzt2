+    if (!hlsl_is_numeric_type(type)
+            || (load->src.path_len && !hlsl_regset_index_from_deref(ctx, &load->src, HLSL_REGSET_NUMERIC, &offset)))
+    {
+        hlsl_fixme(ctx, &load->node.loc, "Only constant numeric FX2 expression loads are supported.");
+        return invalid;
+    }
+    relative = hlsl_type_get_component_offset(ctx, load->node.data_type, component, &regset);
+    offset += relative;
+    if (!var->is_uniform)
+    {
+        const struct hlsl_ir_node *instruction, *source = NULL;
+        unsigned int source_component = 0;
+        bool found_load = false;
+
+        if (!var->is_synthetic)
+        {
+            hlsl_fixme(ctx, &load->node.loc, "Non-uniform FX2 expression variables are not supported.");
+            return invalid;
+        }
+        /* Constructors are already lowered by HLSL into numeric component stores.
+         * Resolve the last preceding store, preserving the load's snapshot semantics. */
+        LIST_FOR_EACH_ENTRY(instruction, &expression->block->instrs, const struct hlsl_ir_node, entry)
+        {
+            const struct hlsl_ir_store *store;
+            unsigned int base = 0, count, destination, rhs_component = 0;
+            struct hlsl_type *destination_type;
+
+            if (instruction == &load->node)
+            {
+                found_load = true;
+                break;
+            }
+            if (instruction->type != HLSL_IR_STORE)
+                continue;
+            store = hlsl_ir_store(instruction);
+            if (store->lhs.var != var)
+                continue;
+            if (store->lhs.path_len && !hlsl_regset_index_from_deref(ctx, &store->lhs, HLSL_REGSET_NUMERIC, &base))
+            {
+                hlsl_fixme(ctx, &instruction->loc, "Dynamic FX2 constructor stores are not supported.");
+                return invalid;
+            }
+            destination_type = hlsl_deref_get_type(ctx, &store->lhs);
+            count = hlsl_type_component_count(store->rhs.node->data_type);
+            if (store->writemask)
+            {
+                for (unsigned int bit = 0; bit < 4; ++bit)
+                {
+                    if (!(store->writemask & (1u << bit)))
+                        continue;
+                    if (base + bit == offset && rhs_component < count)
+                    {
+                        source = store->rhs.node;
+                        source_component = rhs_component;
+                    }
+                    ++rhs_component;
+                }
+            }
+            else
+            {
+                for (rhs_component = 0; rhs_component < count; ++rhs_component)
+                {
+                    destination = base + hlsl_type_get_component_offset(ctx, destination_type, rhs_component, &regset);
+                    if (destination == offset)
+                    {
+                        source = store->rhs.node;
+                        source_component = rhs_component;
+                    }
+                }
+            }
+        }
+        if (found_load && source)
+            return write_fx_2_expression_node(expression, source, source_component);
+        hlsl_fixme(ctx, &load->node.loc, "FX2 constructor component has no preceding definition.");
+        return invalid;
+    }
+
+    /* HLSL offsets follow declaration majority; FX2 parameter values are padded rows. */
+    if (type->class == HLSL_CLASS_MATRIX && !hlsl_type_is_row_major(type))
+        offset = (offset % 4) * 4 + offset / 4;
+    for (size_t i = 0; i < expression->variable_count; ++i)
+        if (expression->variables[i].var == var)
+            return (struct fx_2_expression_operand){2, expression->variables[i].register_index * 4 + offset};
+    if (expression->register_count + type->e.numeric.dimy > UINT16_MAX)
+    {
+        hlsl_fixme(ctx, &load->node.loc, "FX2 expression input register span is too large.");
+        return invalid;
+    }
+    if (!vkd3d_array_reserve((void **)&expression->variables, &expression->variable_capacity,
+                expression->variable_count + 1, sizeof(*expression->variables)))
+    {
+        set_status(expression->fx, VKD3D_ERROR_OUT_OF_MEMORY);
+        return invalid;
+    }
+    expression->variables[expression->variable_count++] =
+            (struct fx_2_expression_variable){var, expression->register_count, type->e.numeric.dimy};
+    relative = expression->register_count * 4 + offset;
+    expression->register_count += type->e.numeric.dimy;
+    return (struct fx_2_expression_operand){2, relative};
+}
