+static struct fx_2_expression_operand write_fx_2_expression_load(
+        struct fx_2_expression *expression, const struct hlsl_ir_load *load, unsigned int component)
+{
+    struct fx_2_expression_operand invalid = {0};
+    const struct hlsl_ir_var *var = load->src.var;
+    struct hlsl_ctx *ctx = expression->fx->ctx;
+    const struct hlsl_type *type = var->data_type;
+    unsigned int offset = 0, relative;
+    enum hlsl_regset regset;
