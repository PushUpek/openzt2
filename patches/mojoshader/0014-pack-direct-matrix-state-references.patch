+void MOJOSHADER_copyEffectNumericParameterToState(
+        const MOJOSHADER_effectValue *source, MOJOSHADER_effectValue *destination)
+{
+    unsigned int count = source->value_count < destination->value_count
+            ? source->value_count : destination->value_count;
+    if ((source->type.parameter_class == MOJOSHADER_SYMCLASS_MATRIX_ROWS
+            || source->type.parameter_class == MOJOSHADER_SYMCLASS_MATRIX_COLUMNS)
+            && source->type.columns < 4)
+    {
+        const unsigned int columns = source->type.columns;
+        const unsigned int components = source->value_count / 4 * columns;
+        count = components < destination->value_count ? components : destination->value_count;
+        memset(destination->values, 0, destination->value_count * sizeof(float));
+        for (unsigned int component = 0; component < count; ++component)
+            memcpy(destination->valuesF + component,
+                    source->valuesF + component / columns * 4 + component % columns, sizeof(float));
+    }
+    else
+        memcpy(destination->values, source->values, count * sizeof(float));
+}
