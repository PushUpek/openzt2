+/* FX2 stores logical rows. CTAB describes the shader's register majority and
+ * therefore the following member's register offset, independently of FX2. */
+static void copy_struct_parameter_data(const MOJOSHADER_effectValue *param,
+                                       const MOJOSHADER_symbol *symbol,
+                                       float *registers)
+{
+    uint32 element, member, array, row, column;
+    uint32 source = 0, destination = symbol->register_index * 4;
+    const uint32 end = destination + symbol->register_count * 4;
+    const uint32 elements = param->type.elements ? param->type.elements : 1;
+    memset(registers + destination, '\0', symbol->register_count * 4 * sizeof(float));
+    for (element = 0; element < elements && destination < end; element++)
+    {
+        for (member = 0; member < param->type.member_count && destination < end; member++)
+        {
+            const MOJOSHADER_symbolTypeInfo *type = &param->type.members[member].info;
+            const MOJOSHADER_symbolTypeInfo *binding = &symbol->info.members[member].info;
+            const uint32 arrays = type->elements ? type->elements : 1;
+            const int columns = binding->parameter_class == MOJOSHADER_SYMCLASS_MATRIX_COLUMNS;
+            const uint32 register_rows = columns ? type->columns : type->rows;
+            for (array = 0; array < arrays && destination < end; array++)
+            {
+                for (row = 0; row < type->rows; row++)
+                {
+                    for (column = 0; column < type->columns; column++)
+                    {
+                        const uint32 target = destination + (columns ? column * 4 + row : row * 4 + column);
+                        if (target < end)
+                            memcpy(registers + target, param->valuesF + source + row * 4 + column, sizeof(float));
+                    }
+                }
+                source += type->rows * 4;
+                destination += register_rows * 4;
+            }
+        }
+    }
+}
